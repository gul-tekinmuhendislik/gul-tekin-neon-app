# Database Connection
DATABASE_URL=<your-neon-database-url>

# Resend Email Configuration
RESEND_API_KEY=<your-resend-api-key>
# Ücretsiz hesap için: onboarding@resend.dev
# Ücretli hesap için kendi domaininizi doğruladıktan sonra: info@yourdomain.com
RESEND_FROM_EMAIL=onboarding@resend.dev

# Email alıcısı (iletişim formundan gelen mesajların gönderileceği adres)
CONTACT_EMAIL_TO=your-email@gmail.com

# Google My Business API Configuration
# Service account key dosyasının yolu
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./service-account-key.json
# Google My Business API'yi etkinleştirmek için true yapın
NEXT_PUBLIC_ENABLE_GMB=false

# Twitter API Configuration
# Twitter API v2 kimlik bilgileri
TWITTER_API_KEY=<your-twitter-api-key>
TWITTER_API_SECRET=<your-twitter-api-secret>
TWITTER_ACCESS_TOKEN=<your-twitter-access-token>
TWITTER_ACCESS_TOKEN_SECRET=<your-twitter-access-token-secret>
TWITTER_BEARER_TOKEN=<your-twitter-bearer-token>

# Twitter API'yi etkinleştirmek için true yapın
NEXT_PUBLIC_ENABLE_TWITTER=true