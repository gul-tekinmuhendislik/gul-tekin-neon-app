# Database Connection
DATABASE_URL=<your-neon-database-url>

# Resend Email Configuration
RESEND_API_KEY=<your-resend-api-key>
# Ücretsiz hesap için: onboarding@resend.dev
# Ücretli hesap için kendi domaininizi doğruladıktan sonra: info@yourdomain.com
RESEND_FROM_EMAIL=onboarding@resend.dev

# Email alıcısı (iletişim formundan gelen mesajların gönderileceği adres)
CONTACT_EMAIL_TO=your-email@gmail.com