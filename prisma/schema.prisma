generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model blog_posts {
  id                   Int       @id @default(autoincrement())
  title                String    @db.VarChar(500)
  slug                 String    @unique @db.VarChar(500)
  content              String
  summary              String?
  image_url            String?
  cloudinary_url       String?
  cloudinary_public_id String?
  category             String?   @db.VarChar(100)
  tags                 String[]
  author               String?   @db.VarChar(100)
  status               String?   @default("draft") @db.VarChar(50)
  published_at         DateTime? @db.Timestamp(6)
  seo_title            String?   @db.VarChar(100)
  seo_description      String?   @db.VarChar(200)
  seo_keywords         String[]
  read_time            Int?
  view_count           Int?      @default(0)
  created_at           DateTime? @default(now()) @db.Timestamp(6)
  updated_at           DateTime? @default(now()) @db.Timestamp(6)

  @@index([created_at(sort: Desc)], map: "idx_blog_posts_created_at")
  @@index([published_at(sort: Desc)], map: "idx_blog_posts_published_at")
  @@index([slug], map: "idx_blog_posts_slug")
  @@index([status], map: "idx_blog_posts_status")
}

model color_schemes {
  id                  Int       @id @default(autoincrement())
  name                String    @unique @db.VarChar(100)
  topic_key           String?   @db.VarChar(100)
  primary_gradient    Json
  accent_colors       Json?
  emotion_description String?
  is_active           Boolean?  @default(true)
  metadata            Json?     @default("{}")
  created_at          DateTime? @default(now()) @db.Timestamp(6)
  updated_at          DateTime? @default(now()) @db.Timestamp(6)

  @@index([is_active], map: "idx_color_schemes_is_active")
  @@index([topic_key], map: "idx_color_schemes_topic_key")
}

model composition_rules {
  id                 Int       @id @default(autoincrement())
  name               String    @db.VarChar(100)
  layout_type        String?   @db.VarChar(100)
  layout_description String?
  focal_point        String?
  spacing_rules      String?
  depth_layers       String?
  margin_rules       String?
  is_active          Boolean?  @default(true)
  metadata           Json?     @default("{}")
  created_at         DateTime? @default(now()) @db.Timestamp(6)
  weight             Int?      @default(100)
  category           String?   @db.VarChar(50)
  use_count          Int?      @default(0)
}

model contact_messages {
  id            Int       @id @default(autoincrement())
  name          String    @db.VarChar(255)
  email         String    @db.VarChar(255)
  subject       String    @db.VarChar(500)
  message       String
  status        String?   @default("new") @db.VarChar(50)
  email_sent    Boolean?  @default(false)
  email_sent_at DateTime? @db.Timestamp(6)
  notes         String?
  created_at    DateTime? @default(now()) @db.Timestamp(6)
  updated_at    DateTime? @default(now()) @db.Timestamp(6)

  @@index([created_at(sort: Desc)], map: "idx_contact_created")
  @@index([email], map: "idx_contact_email")
  @@index([status], map: "idx_contact_status")
}

model event_logs {
  id            Int       @id @default(autoincrement())
  event_name    String    @db.VarChar(255)
  event_type    String?   @db.VarChar(100)
  status        String?   @default("pending") @db.VarChar(50)
  payload       Json?
  metadata      Json?
  error_message String?
  processed_at  DateTime? @db.Timestamp(6)
  created_at    DateTime? @default(now()) @db.Timestamp(6)
  updated_at    DateTime? @default(now()) @db.Timestamp(6)

  @@index([created_at(sort: Desc)], map: "idx_event_logs_created_at")
  @@index([event_name], map: "idx_event_logs_event_name")
  @@index([status], map: "idx_event_logs_status")
}

model faq {
  id          Int       @id @default(autoincrement())
  soru        String
  cevap       String
  kategori    String?   @db.VarChar(50)
  sayfa_tipi  String?   @db.VarChar(20)
  sayfa_slug  String?   @db.VarChar(255)
  siralama_no Int?      @default(0)
  aktif       Boolean?  @default(true)
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  updated_at  DateTime? @default(now()) @db.Timestamp(6)

  @@index([aktif], map: "idx_faq_aktif")
  @@index([kategori], map: "idx_faq_kategori")
  @@index([sayfa_slug], map: "idx_faq_sayfa_slug")
  @@index([sayfa_tipi], map: "idx_faq_sayfa_tipi")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model generated_content {
  id               Int             @id @default(autoincrement())
  topic            String          @db.VarChar(255)
  title            String          @db.VarChar(500)
  content          String
  meta_title       String?         @db.VarChar(100)
  meta_description String?         @db.VarChar(200)
  keywords         String[]
  search_data      Json?
  status           String?         @default("draft") @db.VarChar(50)
  published_at     DateTime?       @db.Timestamp(6)
  created_at       DateTime?       @default(now()) @db.Timestamp(6)
  updated_at       DateTime?       @default(now()) @db.Timestamp(6)
  slug             String?         @unique @db.VarChar(500)
  metadata         Json?           @default("{}")
  prompt           String?
  image_url        String?
  image_prompt     String?
  vertex_images    vertex_images[]

  @@index([created_at(sort: Desc)], map: "idx_content_created")
  @@index([status], map: "idx_content_status")
  @@index([topic], map: "idx_content_topic")
}

model generated_images {
  id                   Int       @id @default(autoincrement())
  original_prompt      String
  enhanced_prompt      String?
  brand_id             String?
  size                 String?   @db.VarChar(20)
  style                String?   @db.VarChar(50)
  status               String?   @default("pending") @db.VarChar(20)
  cloudinary_url       String?
  cloudinary_public_id String?
  created_at           DateTime? @default(now()) @db.Timestamp(6)
  updated_at           DateTime? @default(now()) @db.Timestamp(6)
  metadata             Json?

  @@index([brand_id], map: "idx_generated_images_brand_id")
  @@index([created_at(sort: Desc)], map: "idx_generated_images_created_at")
  @@index([status], map: "idx_generated_images_status")
}

model google_tokens {
  id            Int       @id @default(autoincrement())
  platform      String    @unique @db.VarChar(50)
  access_token  String?
  refresh_token String?
  expires_at    DateTime? @db.Timestamp(6)
  created_at    DateTime? @default(now()) @db.Timestamp(6)
  updated_at    DateTime? @default(now()) @db.Timestamp(6)
}

model hizmet_lokasyonlari {
  id         Int          @id @default(autoincrement())
  ilce_adi   String       @db.VarChar(255)
  slug       String       @unique @db.VarChar(255)
  il         String?      @db.VarChar(100)
  aciklama   String?
  resim_url  String?
  aktif      Boolean?     @default(true)
  sira       Int?         @default(0)
  created_at DateTime?    @default(now()) @db.Timestamp(6)
  updated_at DateTime?    @default(now()) @db.Timestamp(6)
  mahalleler mahalleler[]
}

model hizmetler {
  id                   String    @id
  hizmet_adi           String?
  aciklama             String?
  kategori             String?
  ana_faaliyet_konusu  String[]
  resim_url            String?
  markalar             String[]
  marka_text           String[]
  urunler              String[]
  seo_title            String?
  seo_description      String?
  seo_index            Int?
  aktif                Boolean?  @default(true)
  airtable_modified    DateTime? @db.Timestamp(6)
  synced_at            DateTime? @default(now()) @db.Timestamp(6)
  updated_at           DateTime? @default(now()) @db.Timestamp(6)
  cloudinary_url       String?
  cloudinary_public_id String?
  slug                 String?

  @@index([slug], map: "idx_hizmetler_slug")
}

model mahalleler {
  id                  Int                 @id @default(autoincrement())
  ilce_id             Int
  mahalle_adi         String              @db.VarChar(255)
  slug                String              @db.VarChar(255)
  proje_sayisi        Int?                @default(0)
  created_at          DateTime?           @default(now()) @db.Timestamptz(6)
  updated_at          DateTime?           @default(now()) @db.Timestamptz(6)
  aciklama            String?
  hizmet_lokasyonlari hizmet_lokasyonlari @relation(fields: [ilce_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([ilce_id, slug])
}

model markalar {
  id                    String    @id
  marka_adi             String?
  logo_url              String?
  website               String?
  kategori              String?
  aciklama              String?
  yetkili_servis        Boolean?  @default(false)
  aktif                 Boolean?  @default(true)
  siralama_no           Int?
  airtable_created_time DateTime? @db.Timestamp(6)
  synced_at             DateTime? @default(now()) @db.Timestamp(6)
  updated_at            DateTime? @default(now()) @db.Timestamp(6)
  slug                  String?
  email                 String?
  url                   String?
  cloudinary_url        String?
  cloudinary_public_id  String?
  airtable_hizmetler_id Json?
  airtable_faaliyet_id  Json?
  domain                String?
  domain_status         Int?
}

model navigation_menu {
  id                    Int               @id @default(autoincrement())
  title                 String            @db.VarChar(100)
  href                  String            @db.VarChar(255)
  order_index           Int               @default(0)
  is_active             Boolean?          @default(true)
  parent_id             Int?
  icon                  String?           @db.VarChar(50)
  target                String?           @default("_self") @db.VarChar(20)
  created_at            DateTime?         @default(now()) @db.Timestamp(6)
  updated_at            DateTime?         @default(now()) @db.Timestamp(6)
  navigation_menu       navigation_menu?  @relation("navigation_menuTonavigation_menu", fields: [parent_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  other_navigation_menu navigation_menu[] @relation("navigation_menuTonavigation_menu")
}

model negative_prompts {
  id          Int       @id @default(autoincrement())
  category    String    @db.VarChar(50)
  prompt_text String
  severity    Int?      @default(1)
  is_active   Boolean?  @default(true)
  created_at  DateTime? @default(now()) @db.Timestamp(6)
}

model projeler_gul_tekin {
  id                           Int       @id @default(autoincrement())
  airtable_id                  String    @unique
  proje_adi                    String
  slug                         String?   @unique
  aciklama                     String?
  mahalle                      String?
  ilce                         String?
  baslangic_tarihi             DateTime? @db.Date
  bitis_tarihi                 DateTime? @db.Date
  proje_yili                   String?
  ana_faaliyet_konusu          String[]
  airtable_resim_url           String?
  airtable_galeri_urls         String[]
  cloudinary_url               String?
  cloudinary_public_id         String?
  cloudinary_galeri_urls       String[]
  cloudinary_galeri_public_ids String[]
  aktif                        Boolean?  @default(true)
  sira                         Int?      @default(999)
  airtable_last_modified       DateTime? @db.Timestamp(6)
  created_at                   DateTime? @default(now()) @db.Timestamp(6)
  updated_at                   DateTime? @default(now()) @db.Timestamp(6)
  synced_at                    DateTime? @default(now()) @db.Timestamp(6)

  @@index([airtable_id], map: "idx_projeler_gul_tekin_airtable_id")
  @@index([aktif], map: "idx_projeler_gul_tekin_aktif")
  @@index([cloudinary_url], map: "idx_projeler_gul_tekin_cloudinary_url")
  @@index([slug], map: "idx_projeler_gul_tekin_slug")
}

model regional_themes {
  id                Int       @id @default(autoincrement())
  region_name       String    @db.VarChar(100)
  region_key        String?   @unique @db.VarChar(100)
  visual_elements   String?
  cultural_motifs   String?
  seasonal_variants Json?
  keywords          Json?
  is_active         Boolean?  @default(true)
  created_at        DateTime? @default(now()) @db.Timestamp(6)
}

model search_results {
  id                    Int       @id @default(autoincrement())
  search_query          String    @db.VarChar(500)
  search_type           String?   @default("auto") @db.VarChar(100)
  result_title          String?
  result_url            String?   @unique(map: "unique_result_url")
  result_content        String?
  result_score          Float?
  result_published_date DateTime? @db.Timestamp(6)
  result_author         String?   @db.VarChar(255)
  highlights            String[]
  metadata              Json?
  created_at            DateTime? @default(now()) @db.Timestamp(6)
  updated_at            DateTime? @default(now()) @db.Timestamp(6)
  domain                String?

  @@index([created_at(sort: Desc)], map: "idx_search_results_created_at")
  @@index([search_query], map: "idx_search_results_query")
  @@index([result_score(sort: Desc)], map: "idx_search_results_score")
  @@index([result_url], map: "idx_search_results_url")
}

model seo_backlinks {
  id               Int       @id @default(autoincrement())
  source_url       String
  target_url       String
  anchor_text      String?
  follow           Boolean?  @default(true)
  domain_authority Int?
  first_seen       DateTime? @default(dbgenerated("CURRENT_DATE")) @db.Date
  last_checked     DateTime? @default(now()) @db.Timestamp(6)
  status           String?   @default("active") @db.VarChar(20)

  @@unique([source_url, target_url])
}

model seo_errors {
  id             Int       @id @default(autoincrement())
  url            String
  error_type     String?   @db.VarChar(50)
  error_code     Int?
  error_message  String?
  priority       String?   @db.VarChar(20)
  first_detected DateTime? @default(now()) @db.Timestamp(6)
  resolved       Boolean?  @default(false)
  resolved_at    DateTime? @db.Timestamp(6)

  @@index([resolved], map: "idx_seo_errors_resolved")
}

model seo_pages {
  id               Int       @id @default(autoincrement())
  url              String    @unique
  title            String?
  meta_description String?
  indexed          Boolean?  @default(false)
  mobile_friendly  Boolean?  @default(true)
  load_time        Decimal?  @db.Decimal(5, 2)
  core_web_vitals  Json?
  last_crawled     DateTime? @db.Timestamp(6)
  created_at       DateTime? @default(now()) @db.Timestamp(6)
  updated_at       DateTime? @default(now()) @db.Timestamp(6)

  @@index([indexed], map: "idx_seo_pages_indexed")
}

model sites_domain {
  id       Int     @id @default(autoincrement())
  siteadi  String?
  url      String?
  kategori String?
  icon     String?
}

model social_media_posts {
  id                 Int       @id @default(autoincrement())
  content_id         Int
  platform           String    @db.VarChar(50)
  post_id            String?   @db.VarChar(255)
  post_data          Json
  status             String    @default("pending") @db.VarChar(50)
  posted_at          DateTime? @db.Timestamptz(6)
  scheduled_for      DateTime? @db.Timestamptz(6)
  error_message      String?
  engagement_metrics Json?
  created_at         DateTime? @default(now()) @db.Timestamptz(6)
  updated_at         DateTime? @default(now()) @db.Timestamptz(6)

  @@unique([content_id, platform])
  @@index([content_id], map: "idx_social_media_posts_content_id")
  @@index([platform], map: "idx_social_media_posts_platform")
  @@index([posted_at(sort: Desc)], map: "idx_social_media_posts_posted_at")
  @@index([status], map: "idx_social_media_posts_status")
}

model social_tokens {
  id            Int       @id @default(autoincrement())
  platform      String    @db.VarChar(50)
  token_type    String    @db.VarChar(50)
  access_token  String
  refresh_token String?
  page_id       String?   @db.VarChar(255)
  page_name     String?   @db.VarChar(255)
  expires_at    DateTime? @db.Timestamp(6)
  scopes        String[]
  metadata      Json?     @default("{}")
  is_active     Boolean?  @default(true)
  created_at    DateTime? @default(now()) @db.Timestamp(6)
  updated_at    DateTime? @default(now()) @db.Timestamp(6)

  @@unique([platform, token_type])
}

model style_presets {
  id              Int       @id @default(autoincrement())
  name            String    @unique @db.VarChar(100)
  category        String?   @db.VarChar(50)
  main_style      String
  effects         Json?
  render_style    String?   @db.VarChar(100)
  atmosphere      String?
  technical_specs String?
  is_active       Boolean?  @default(true)
  created_at      DateTime? @default(now()) @db.Timestamp(6)
}

model token_refresh_logs {
  id             Int       @id @default(autoincrement())
  platform       String    @db.VarChar(50)
  token_id       Int?
  refresh_status String    @db.VarChar(20)
  old_expires_at DateTime? @db.Timestamp(6)
  new_expires_at DateTime? @db.Timestamp(6)
  error_message  String?
  metadata       Json?     @default("{}")
  created_at     DateTime? @default(now()) @db.Timestamp(6)
}

model twitter_posts {
  id                   Int       @id @default(autoincrement())
  tweet_id             String?   @db.VarChar(100)
  content              String
  media_urls           String[]
  post_type            String?   @db.VarChar(50)
  related_content_id   Int?
  related_content_type String?   @db.VarChar(50)
  engagement           Json?
  posted_at            DateTime? @default(now()) @db.Timestamp(6)
  status               String?   @default("posted") @db.VarChar(20)
}

model twitter_tokens {
  id            Int       @id @default(autoincrement())
  user_id       String    @unique @db.VarChar(50)
  username      String    @db.VarChar(100)
  access_token  String
  refresh_token String?
  expires_at    DateTime? @db.Timestamp(6)
  scope         String?
  created_at    DateTime? @default(now()) @db.Timestamp(6)
  updated_at    DateTime? @default(now()) @db.Timestamp(6)
}

model urunler {
  id                    String    @id
  urun_adi              String?
  slug                  String?
  aciklama              String?
  fiyat                 Decimal?  @db.Decimal(10, 2)
  kategori              String?
  marka                 String?
  sku                   String?
  stokta                Boolean?  @default(true)
  etiketler             String[]
  gorsel_url            String?
  aktif                 Boolean?  @default(true)
  siralama_no           Int?
  ozellikler            String?
  agirlik               Decimal?  @db.Decimal(8, 2)
  boyutlar              String?
  airtable_created_time DateTime? @db.Timestamp(6)
  synced_at             DateTime? @default(now()) @db.Timestamp(6)
  updated_at            DateTime? @default(now()) @db.Timestamp(6)
  cloudinary_url        String?
  cloudinary_public_id  String?
  hizmet_id             String?
  hizmet_adi            String?
  anasayfa_goster       Boolean?  @default(false)

  @@index([anasayfa_goster], map: "idx_urunler_anasayfa")
  @@index([slug], map: "idx_urunler_slug")
}

model vertex_images {
  id                   Int                @id @default(autoincrement())
  prompt               String
  enhanced_prompt      String?
  image_url            String
  cloudinary_public_id String             @unique
  cloudinary_urls      Json?              @default("{}")
  responsive_urls      Json?              @default("{}")
  model                String?            @default("imagen-3.0-generate-001") @db.VarChar(100)
  provider             String?            @default("vertex-ai") @db.VarChar(50)
  aspect_ratio         String?            @default("16:9") @db.VarChar(20)
  width                Int?
  height               Int?
  format               String?            @db.VarChar(20)
  bytes                Int?
  tags                 String[]
  content_id           Int?
  generation_params    Json?              @default("{}")
  metadata             Json?              @default("{}")
  status               String?            @default("completed") @db.VarChar(50)
  error_message        String?
  created_at           DateTime?          @default(now()) @db.Timestamp(6)
  updated_at           DateTime?          @default(now()) @db.Timestamp(6)
  generated_content    generated_content? @relation(fields: [content_id], references: [id], onUpdate: NoAction)

  @@index([cloudinary_public_id], map: "idx_vertex_images_cloudinary_public_id")
  @@index([content_id], map: "idx_vertex_images_content_id")
  @@index([created_at(sort: Desc)], map: "idx_vertex_images_created_at")
  @@index([status], map: "idx_vertex_images_status")
}

model visual_elements {
  id           Int       @id @default(autoincrement())
  name         String    @db.VarChar(100)
  topic_key    String?   @db.VarChar(100)
  element_type String    @db.VarChar(50)
  description  String
  weight       Int?      @default(100)
  is_active    Boolean?  @default(true)
  metadata     Json?     @default("{}")
  created_at   DateTime? @default(now()) @db.Timestamp(6)
}
